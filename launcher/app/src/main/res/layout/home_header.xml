<?xml version="1.0" encoding="utf-8"?>
<!-- Greeting, clock and date: the top-left block of Home (activity_main) and of the Home screensaver (HomeDream). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <!-- The header texts use gravity left, not start: the launcher lays out left to right
         (no supportsRtl), and with start a right-to-left script such as Arabic would move to the
         right edge of these full-width lines instead of staying under the clock. -->
    <TextView
        android:id="@+id/greeting"
        android:gravity="left"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:singleLine="true"
        android:ellipsize="end"
        android:layout_marginStart="4dp"
        android:textColor="#8CFFFFFF"
        android:textSize="12sp"
        android:fontFamily="@font/outfit_medium"
        android:letterSpacing="0.22"
        android:textAllCaps="true" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:baselineAligned="true">

        <TextClock
            android:id="@+id/clock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:format12Hour="h:mm"
            android:format24Hour="HH:mm"
            android:textColor="#FFFFFFFF"
            android:textSize="52sp"
            android:fontFamily="@font/outfit_light"
            android:letterSpacing="-0.04"
            android:includeFontPadding="false" />

        <TextClock
            android:id="@+id/ampm"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_gravity="bottom"
            android:layout_marginBottom="8dp"
            android:format12Hour="a"
            android:format24Hour=""
            android:textColor="#B3FFFFFF"
            android:textSize="15sp"
            android:fontFamily="@font/outfit_medium"
            android:letterSpacing="0.08"
            android:textAllCaps="true" />

        <View
            android:layout_width="1dp"
            android:layout_height="26dp"
            android:layout_gravity="bottom"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="8dp"
            android:background="#33FFFFFF" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:layout_marginBottom="9dp"
            android:orientation="vertical">

            <!-- Shamsi date ("27 Mehr 1405"), shown when shamsi_date is on. -->
            <TextView
                android:id="@+id/shamsiDate"
                android:gravity="left"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:ellipsize="end"
                android:textColor="#E6FFFFFF"
                android:textSize="17sp"
                android:fontFamily="@font/outfit_regular"
                android:letterSpacing="0.02"
                android:includeFontPadding="false"
                android:visibility="gone" />

            <TextClock
                android:id="@+id/date"
                android:gravity="left"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:singleLine="@bool/date_single_line"
                android:maxLines="2"
                android:lineSpacingExtra="6dp"
                android:ellipsize="end"
                android:format12Hour="@string/date_format_home"
                android:format24Hour="@string/date_format_home"
                android:textColor="#A6FFFFFF"
                android:textSize="14sp"
                android:fontFamily="@font/outfit_regular"
                android:letterSpacing="0.14"
                android:textAllCaps="true" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
